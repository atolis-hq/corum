{
  "$description": "The Corum styling contract (ADR-011): every public design token, in W3C DTCG format. A token's CSS custom property is `--` plus the last segment of its path (color.background is --background). `$value` is the default (light) theme value; other themes (dark, high-contrast, and any plugin's) are plugin contributions that set these same tokens; the built-in ones live in web/builtin/themes. Run `npm run tokens` after editing: it regenerates web/tokens.css and web/builtin/themes/light.css, which a test keeps in sync.",
  "$extensions": {
    "corum": {
      "version": 2
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": "#ffffff",
      "$description": "Page and canvas background.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "card": {
      "$value": "#f7f7f8",
      "$description": "Raised surface: cards, panels, the nav rail.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "muted": {
      "$value": "#eeeef1",
      "$description": "Subdued fill for chips, code and hover states.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "foreground": {
      "$value": "#141519",
      "$description": "Primary text.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "secondary-foreground": {
      "$value": "#3a3c43",
      "$description": "Secondary text, one step below foreground.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "muted-foreground": {
      "$value": "#6c6f78",
      "$description": "Labels, captions and other de-emphasised text.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "subtle-foreground": {
      "$value": "#a8acb5",
      "$description": "Placeholder and disabled text, and the neutral fallback for a node with no pack colour.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "border": {
      "$value": "#e4e6ea",
      "$description": "Default hairline border.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "border-strong": {
      "$value": "#cdd0d6",
      "$description": "Border for controls and dividers that must stay visible.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "accent": {
      "$value": "#e8614a",
      "$description": "Brand accent: primary actions, the active nav item, links.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "accent-soft": {
      "$value": "#fde6e0",
      "$description": "Tinted background for accent-coloured badges.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "accent-text": {
      "$value": "#b3422e",
      "$description": "Accent-coloured text that must be readable on accent-soft.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "success": {
      "$value": "#3b9a66",
      "$description": "Positive status.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "warning": {
      "$value": "#a8480a",
      "$description": "Warning status; a dark orange that keeps warning text readable on the page background.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "ring": {
      "$value": "{color.accent}",
      "$description": "Focus ring colour.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "destructive": {
      "$value": "#cc4444",
      "$description": "Errors and destructive actions.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "info": {
      "$value": "#3b6fb3",
      "$description": "Informational status.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "on-accent": {
      "$value": "#ffffff",
      "$description": "Text and icons on an accent fill.",
      "$extensions": { "corum": { "since": 1, "origin": "material" } }
    },
    "on-solid": {
      "$value": "#ffffff",
      "$description": "Text and icons on a solid status or pack-colour fill.",
      "$extensions": { "corum": { "since": 1, "origin": "material" } }
    },
    "scrim": {
      "$value": "rgba(0, 0, 0, 0.4)",
      "$description": "Backdrop behind modal overlays.",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "overlay-secondary": {
      "$value": "#5c7aa8",
      "$description": "Second series colour in comparison overlays (the first is accent).",
      "$extensions": { "corum": { "since": 1, "origin": "corum" } }
    },
    "edge-default": {
      "$value": "#6c6f78",
      "$description": "Colour of an edge type that declares no colour in its pack.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-1": {
      "$value": "#2f6fb0",
      "$description": "Kind colour 1. The default kind (component) always uses it.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-2": {
      "$value": "#b0562f",
      "$description": "Kind colour 2.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-3": {
      "$value": "#4a8a3c",
      "$description": "Kind colour 3.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-4": {
      "$value": "#8a3c7a",
      "$description": "Kind colour 4.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-5": {
      "$value": "#b08a2f",
      "$description": "Kind colour 5.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-6": {
      "$value": "#2f8a8a",
      "$description": "Kind colour 6.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-7": {
      "$value": "#7a3c3c",
      "$description": "Kind colour 7.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "kind-8": {
      "$value": "#5a5ab0",
      "$description": "Kind colour 8.",
      "$extensions": { "corum": { "since": 2, "origin": "corum" } }
    },
    "node-colour": {
      "$value": "{color.subtle-foreground}",
      "$description": "Input: the pack or kind colour of a node-coloured element. Set it with templateColourStyle() or kindColour(); never write it in a stylesheet.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "input" } }
    },
    "edge-colour": {
      "$value": "{color.edge-default}",
      "$description": "Input: the pack colour of an edge-coloured element. Set it with edgeTypeStyle(); never write it in a stylesheet.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "input" } }
    },
    "node-tint": {
      "$value": "color-mix(in srgb, var(--node-colour) 14%, var(--card))",
      "$description": "Derived by the node-coloured class: background tint of a pack-coloured node.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "derived" } }
    },
    "node-border": {
      "$value": "color-mix(in srgb, var(--node-colour) 70%, var(--foreground))",
      "$description": "Derived by the node-coloured class: border of a pack-coloured node.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "derived" } }
    },
    "node-on-tint": {
      "$value": "color-mix(in srgb, var(--node-colour) 45%, var(--foreground))",
      "$description": "Derived by the node-coloured class: text on node-tint.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "derived" } }
    },
    "edge-tint": {
      "$value": "color-mix(in srgb, var(--edge-colour) 14%, var(--card))",
      "$description": "Derived by the edge-coloured class: background tint of an edge-type tag or pill.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "derived" } }
    },
    "edge-border": {
      "$value": "color-mix(in srgb, var(--edge-colour) 70%, var(--foreground))",
      "$description": "Derived by the edge-coloured class: border of an edge-type tag or pill.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "derived" } }
    },
    "edge-on-tint": {
      "$value": "color-mix(in srgb, var(--edge-colour) 45%, var(--foreground))",
      "$description": "Derived by the edge-coloured class: text on edge-tint.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "derived" } }
    }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": {
      "$value": { "color": "rgba(0, 0, 0, 0.06)", "offsetX": "0", "offsetY": "1px", "blur": "4px", "spread": "0" },
      "$description": "Small elevation: cards and chips.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "shadow-md": {
      "$value": { "color": "rgba(0, 0, 0, 0.1)", "offsetX": "0", "offsetY": "2px", "blur": "8px", "spread": "0" },
      "$description": "Medium elevation: popovers and menus.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "shadow-lg": {
      "$value": { "color": "rgba(0, 0, 0, 0.12)", "offsetX": "0", "offsetY": "4px", "blur": "16px", "spread": "0" },
      "$description": "Large elevation: floating panels.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "shadow-xl": {
      "$value": [
        { "color": "rgba(0, 0, 0, 0.25)", "offsetX": "0", "offsetY": "8px", "blur": "40px", "spread": "0" },
        { "color": "rgba(0, 0, 0, 0.1)", "offsetX": "0", "offsetY": "2px", "blur": "8px", "spread": "0" }
      ],
      "$description": "Extra-large elevation: modal dialogs.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "radius-sm": {
      "$value": "4px",
      "$description": "Small corner radius: chips, tags, inputs.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "radius": {
      "$value": "6px",
      "$description": "Default corner radius: buttons, cards, menus.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    },
    "radius-lg": {
      "$value": "10px",
      "$description": "Large corner radius: dialogs and large panels.",
      "$extensions": { "corum": { "since": 1, "origin": "shadcn" } }
    }
  },
  "font": {
    "font-mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "monospace"],
      "$description": "Optional: monospace font stack. Not set by default; the stylesheet falls back to JetBrains Mono, so a theme may set it to change the monospace font.",
      "$extensions": { "corum": { "since": 1, "origin": "corum", "scope": "optional" } }
    }
  },
  "layout": {
    "nav-width": {
      "$type": "dimension",
      "$value": "72px",
      "$description": "Layout: width of the desktop nav rail (48px to 120px). Set by a layout (contributes.layouts), never by a theme. The mobile rail ignores it.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "layout" } }
    },
    "content-max": {
      "$type": "dimension",
      "$value": "none",
      "$description": "Layout: maximum width of the page content (`none`, or 480px to 2400px). Set by a layout, never by a theme.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "layout" } }
    },
    "density": {
      "$type": "number",
      "$value": "1",
      "$description": "Layout: spacing multiplier for the nav rail and page content padding (0.5 to 1.5). Set by a layout, never by a theme.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "layout" } }
    }
  },
  "stroke": {
    "edge-dash": {
      "$type": "strokeStyle",
      "$value": "solid",
      "$description": "Input: stroke-dasharray of an edge type (`none` for solid). Set it with edgeTypeStyle(); never write it in a stylesheet.",
      "$extensions": { "corum": { "since": 2, "origin": "corum", "scope": "input" } }
    }
  }
}
