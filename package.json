{
  "name": "@atolis-hq/corum",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/atolis-hq/corum"
  },
  "files": [
    "dist/src/",
    "web/"
  ],
  "bin": {
    "corum": "dist/src/bin/corum.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node scripts/run-tests.mjs",
    "tokens": "node scripts/generate-tokens.mjs",
    "styling:snapshot": "node scripts/update-styling-snapshot.mjs",
    "wireframes": "node design/wireframes/server.mjs",
    "mcp": "node dist/src/mcp/index.js",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "mcp:write-smoke": "npm run build && node scripts/mcp-write-smoke.mjs",
    "web": "node dist/src/web/server.js",
    "test:web": "npm run build && playwright test",
    "screenshots:publish": "node scripts/publish-screenshots.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@asyncapi/parser": "^3.6.0",
    "@babel/standalone": "7.29.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@toon-format/toon": "^2.1.0",
    "commander": "^14.0.3",
    "elkjs": "0.12.1",
    "express": "^4.22.1",
    "htm": "3.1.1",
    "isomorphic-git": "^1.37.6",
    "openapi-types": "^12.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4",
    "semver": "7.8.6",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/swagger-parser": "^4.0.3",
    "typescript": "^5.0.0"
  }
}
